+class SemanticCSIGate(nn.Module):
+    """
+    LECLN-style bottleneck gate for CSI residual reliability.
+
+    LECLN fuses wireless pilot features and LiDAR features with a sigmoid
+    bottleneck. Here, we fuse WiFo CSI features and FPN semantic features to
+    decide how much of the predicted CSI residual should be trusted.
+    """
+    def __init__(self, nr, nt, hidden_dim=128, init_bias=-1.3862944):
+        super().__init__()
+        csi_dim = nr * nt * 2 * 3
+        in_dim = 256 + csi_dim + 1
+
+        self.net = nn.Sequential(
+            nn.Linear(in_dim, hidden_dim),
+            nn.GELU(),
+            nn.Linear(hidden_dim, hidden_dim),
+            nn.GELU(),
+            nn.Linear(hidden_dim, 1),
+        )
+        nn.init.zeros_(self.net[-1].weight)
+        nn.init.constant_(self.net[-1].bias, init_bias)
+
+    @staticmethod
+    def _complex_to_vec(h):
+        return torch.stack([h.real, h.imag], dim=-1).flatten(1)
+
+    def forward(self, semantic_vec, h_outdated, delta_h, h_pred, snr_db=None):
+        csi_vec = torch.cat(
+            [
+                self._complex_to_vec(h_outdated),
+                self._complex_to_vec(delta_h),
+                self._complex_to_vec(h_pred),
+            ],
+            dim=1,
+        )
+        if snr_db is None:
+            snr_feat = torch.zeros(
+                h_outdated.shape[0], 1, device=h_outdated.device, dtype=semantic_vec.dtype
+            )
+        else:
+            snr = torch.as_tensor(
+                snr_db, device=h_outdated.device, dtype=semantic_vec.dtype
+            ).view(-1)
+            if snr.numel() == 1 and h_outdated.shape[0] > 1:
+                snr = snr.expand(h_outdated.shape[0])
+            snr_feat = snr.view(-1, 1) / 20.0
+
+        x = torch.cat([semantic_vec, csi_vec.to(semantic_vec.dtype), snr_feat], dim=1)
+        return torch.sigmoid(self.net(x)).view(-1, 1, 1)
