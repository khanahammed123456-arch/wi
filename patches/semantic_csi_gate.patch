+    def _build_semantic_vector(self, pyramid_tx):
+        if not isinstance(pyramid_tx, dict):
+            raise ValueError("Semantic CSI gate expects FPN dictionary features.")
+
+        pooled = []
+        for name in ("p2", "p3", "p4", "p5"):
+            if name in pyramid_tx:
+                pooled.append(pyramid_tx[name].mean(dim=(-2, -1)))
+
+        if len(pooled) == 0:
+            raise ValueError("No usable FPN features found for semantic CSI gate.")
+
+        return torch.stack(pooled, dim=0).mean(dim=0).to(torch.float32)
